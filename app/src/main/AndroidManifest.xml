<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: permiso en tiempo de ejecución para mostrar notificaciones push (T142). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      La app usa Firebase Analytics pero no muestra ni atribuye publicidad. Firebase declara estos
      permisos por defecto; se quitan para no pedir el ID de publicidad ni la atribución de
      Privacy Sandbox. Analytics, Crashlytics y FCM siguen funcionando (sin ID de publicidad).
      Debe coincidir con la declaración "Seguridad de los datos" de Play.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />

    <application
        android:name=".UrbanBladeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="UrbanBlade"
        android:supportsRtl="true"
        android:theme="@style/Theme.UrbanBlade">
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Enlaces de los correos: urbanblade://open?route=<pantalla> (la web los envía desde /abrir). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="urbanblade" android:host="open" />
            </intent-filter>
        </activity>

        <!-- Botones de la notificación «tu servicio termina en 5 min»: terminar ya / +10 / +15 min. -->
        <receiver
            android:name=".core.push.ServiceActionReceiver"
            android:exported="false" />

        <!-- Recepción de notificaciones push de Firebase Cloud Messaging (T142). -->
        <service
            android:name=".core.push.UrbanMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="citas" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_urbanblade" />
    </application>
</manifest>
